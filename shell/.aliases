# ~/.aliases — alias condivisi fra zsh e bash.
# Sourced da ~/.zshrc e/o ~/.bashrc (vedi repo dotfiles/shell/).
# Qui solo alias: variabili d'ambiente (EDITOR, PATH…) vanno nei rc
# specifici della shell, non qui.

# ---------- Navigazione ----------
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'

# ---------- Sicurezza (evita sovrascritture per errore) ----------
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# ---------- Git ----------
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
alias gb='git branch'

# ---------- Utility ----------
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'

# ----------
alias tree='tree -a -I .git'
alias pandoc='pandoc --pdf-engine=typst'

# Alias 'cat' solo se 'bat' è disponibile, altrimenti resta il cat di sistema.
if command -v bat >/dev/null 2>&1; then
    alias cat='bat --paging=never'
fi


# --- concat + copia in clipboard -------------------------------------
_copy_to_clipboard() {
    if command -v pbcopy >/dev/null 2>&1; then
        pbcopy                                   # macOS
    elif command -v wl-copy >/dev/null 2>&1; then
        wl-copy                                  # Linux Wayland
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard               # Linux X11
    elif command -v xsel >/dev/null 2>&1; then
        xsel --clipboard --input                 # Linux X11 (alternativa)
    else
        echo "concat: nessun tool clipboard trovato (pbcopy/wl-copy/xclip/xsel)" >&2
        return 1
    fi
}

concat() {
    local dryrun=0 a
    for a in "$@"; do
        case "$a" in
            -n|--dry-run) dryrun=1; break ;;
        esac
    done

    command concat -X .gitignore "$@" || return $?
    [ "$dryrun" -eq 1 ] && return 0

    local out="output.txt"
    
    if [ $# -ge 2 ]; then
        for out in "$@"; do :; done
        [ -d "$out" ] && out="output.txt"
    fi

    _copy_to_clipboard < "$out" && echo "Copiato $out nella clipboard."
}
