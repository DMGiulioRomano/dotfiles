#!/bin/sh
# Da' a ogni window di tmux una sfumatura di sfondo in base al suo numero.
# Le tonalita' sono fisse, vicine allo sfondo del tema shades-of-purple.
tmux list-windows -a -F '#{window_id} #{window_index}' |
while read -r id index; do
  case $((index % 4)) in
    1) bg='#1e1e3f' ;;
    2) bg='#25254c' ;;
    3) bg='#1a1a35' ;;
    0) bg='#222247' ;;
  esac
  tmux set-window-option -t "$id" window-style "bg=$bg"
done
